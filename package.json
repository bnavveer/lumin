{
  "name": "aid",
  "version": "1.0.0",
  "description": "A one-page interactive guide to what a low-income person can qualify for, like food stamps, Medi-Cal/Medicaid and Section 8, and where to apply for each. It covers federal rules for every state, plus a detailed California section.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnavveer/aid.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/bnavveer/aid/issues"
  },
  "homepage": "https://github.com/bnavveer/aid#readme",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.109",
    "@getdial/sdk": "^0.41.1",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.3",
    "ai": "^5.0.273",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
