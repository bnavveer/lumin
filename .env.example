# Copy to .env and fill in. Never commit real values.

# ── Supabase (auth, records, storage) ──
SUPABASE_URL=
# Public key, served to the dashboard via /api/public-config
SUPABASE_PUBLISHABLE_KEY=
# Service-role key, server only
SUPABASE_SECRET_KEY=
# Database password (migrations / direct SQL scripts)
SUPABASE_DB_PASSWORD=
INTAKE_STORE=                   # "memory" for a local trial; otherwise persistent Supabase

# ── Keewano (agent memory + analytics) ──
KEEWANO_SDK_KEY=
KEEWANO_PROJECT_ID=
# Personal access token for SQL queries (autopilot, Ask Keewano)
KEEWANO_PAT=
KEEWANO_PG_USER=

# ── Neon AI Gateway (all LLM calls) ──
NEON_AI_GATEWAY_BASE_URL=
# Generic token, used when a per-task token is not set
NEON_AI_GATEWAY_TOKEN=
NEON_AI_TOKEN_AGENT=
NEON_AI_TOKEN_FAST=
NEON_AI_TOKEN_VISION=
# Also used for embeddings
NEON_AI_TOKEN_KNOWLEDGE=
# Optional model overrides per task: AID_MODEL_AGENT, AID_MODEL_FAST, AID_MODEL_VISION, AID_MODEL_TRANSLATE, AID_MODEL_KNOWLEDGE, AID_MODEL_AUDIO
AID_MODEL=
AID_MODEL_AGENT=
AID_MODEL_FAST=
AID_MODEL_VISION=
AID_MODEL_TRANSLATE=
AID_MODEL_KNOWLEDGE=
AID_MODEL_AUDIO=
# Direct Anthropic key, last-resort fallback when no gateway is configured
ANTHROPIC_API_KEY=
# Set to 0 to skip the LLM inbox classifier
AID_LLM_CLASSIFY=

# ── Dial (SMS + voice transport) ──
DIAL_API_KEY=
DIAL_WEBHOOK_SECRET=
DIAL_FROM_NUMBER=              # E.164, number id, or nickname
PUBLIC_DIAL_NUMBER=            # E.164 override for website call/text links
DIAL_ENABLED=true             # false disables the listener for web-only development

# ── Kernel (cloud browser for the BenefitsCal form-filler) ──
KERNEL_API_KEY=

# ── AgentMail (per-case inbox, county email) ──
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Sender inbox used by POST /api/demo/county-email
AGENTMAIL_DEMO_INBOX=

# ── Exa (web knowledge + waitlist watcher) ──
EXA_API_KEY=

# ── Devin (deep dives, document extraction fallback) ──
DEVIN_API_KEY=

# ── App settings ──
# true = unauthenticated staff routes, canned fallbacks, /api/dev/* and /api/demo/* routes
DEMO_MODE=false
# Signs the /p/:id packet links
PACKET_LINK_SECRET=
# Public URL of this API (packet links, Kernel browser reaching the mock site)
PUBLIC_BASE_URL=
PORT=3000
# Phone number (E.164) of the live-demo participant, used by scripts/seed.ts
DEMO_PERSON_B_PHONE=
# Autopilot loop (src/demoRunner.ts): false disables it
AUTOPILOT_ENABLED=
# Tick interval in ms (default 120000)
AUTOPILOT_MS=
# Comma-separated household ids the autopilot may text
AUTOPILOT_ALLOW=

# Trust X-Forwarded-For only behind a known proxy/tunnel (cloudflared, Fly). Leave false for direct local runs.
TRUST_PROXY=
