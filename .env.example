# Copy to .env (gitignored) and fill in. Never commit real values.

# Claude (agent + call transcript extraction)
ANTHROPIC_API_KEY=

# Dial: texts, calls and the event stream
DIAL_API_KEY=sk_live_...
DIAL_FROM_NUMBER=+1...          # our Dial line (E.164, number id, or nickname)
PUBLIC_DIAL_NUMBER=             # optional E.164 override for website call/text links
DIAL_ENABLED=true              # false disables the inbound listener for local web-only development

# Supabase (households, intakes, conversation thread, dedupe)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
INTAKE_STORE=                   # "memory" to keep intakes/threads in-process for a quick local try

# Keewano (case events)
KEEWANO_SDK_KEY=
KEEWANO_PAT=kwpat-...
KEEWANO_PG_USER=you@email.com
KEEWANO_PROJECT_ID=

# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PACKET_LINK_SECRET=             # long random string; signs packet links sent by text
DEMO_MODE=false
DEMO_PERSON_B_PHONE=+1...
